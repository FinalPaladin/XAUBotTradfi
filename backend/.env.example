# Application
APP_NAME=XAUBot TradFi
DEBUG=false

# MySQL (create database XAUBOT before first run)
DATABASE_URL=mysql+pymysql://root:123qwe@localhost:3306/XAUBOT?charset=utf8mb4

# CORS (comma-separated origins for React UI later)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MetaTrader 5 — run worker on Windows with MT5 terminal open
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trial17
WORKER_TICK_SECONDS=5
# Worker tự thoát nếu 1 tick kẹt quá lâu (MT5 IPC treo) — restart worker thủ công
WORKER_TICK_TIMEOUT_SECONDS=90

# Telegram trade alerts (channel id thường dạng -100xxxxxxxxxx)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1004486389497

# JWT & secure key (must match frontend VITE_SECRET_KEY_DYNAMIC)
JWT_SECRET_KEY=change-me-in-production-use-long-random-string
SECRET_KEY_DYNAMIC=xaubot-secure-key-dynamic-dev
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Bootstrap admin (created when users table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123qwe
ADMIN_EMAIL=admin@local
